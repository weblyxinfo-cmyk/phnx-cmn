# Turso (libSQL) — production DB
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=

# Admin auth — JWT_SECRET musí mít alespoň 16 znaků, jinak app spadne při startu
JWT_SECRET=
ADMIN_PASSWORD=

# Vercel Blob — pro uploady log v admin panelu
BLOB_READ_WRITE_TOKEN=

# Resend — odesílání zpráv z kontaktního formuláře
# https://resend.com/api-keys
RESEND_API_KEY=
CONTACT_TO_EMAIL=praha@phoenixcom.cz
CONTACT_FROM_EMAIL=Phoenix Web <onboarding@resend.dev>
